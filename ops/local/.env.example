# Copy values into a local untracked .env and replace the placeholder secret.
APP_ENV=local
EXECUTION_MODE=mock
DATABASE_URL=sqlite:///../../var/alpha_defense.db
CONTENT_ROOT=../../content
FIXTURE_ROOT=../../fixtures
MEDIA_ROOT=../../var/media
SESSION_SECRET=replace-with-at-least-32-random-characters
POLICY_VERSION=demo-risk-v1
ANALYSIS_DEADLINE_MS=3000
CALL_PROOF_TTL_SECONDS=300
TRANSFER_CHECK_TTL_SECONDS=300
CORRELATION_WINDOW_SECONDS=3600
RESEARCH_ENABLED=false
TRUSTED_SUPPORT_CONTACT=900
CORS_ALLOW_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=127.0.0.1,localhost
MAX_REQUEST_BODY_BYTES=1048576
