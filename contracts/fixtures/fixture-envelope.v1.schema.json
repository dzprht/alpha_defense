{
  "$id": "https://alpha-defense.test/schemas/fixture-envelope.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "fixture_id": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "fixture_version": {
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "communication",
        "threat"
      ],
      "type": "string"
    },
    "locale": {
      "const": "ru-RU",
      "type": "string"
    },
    "payload": {
      "minProperties": 1,
      "type": "object"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "fixture_id": {
            "pattern": "^[a-z][a-z0-9-]{2,63}$",
            "type": "string"
          },
          "fixture_version": {
            "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$",
            "type": "string"
          },
          "path": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._/-]*\\.json$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256",
          "fixture_id",
          "fixture_version"
        ],
        "type": "object"
      },
      "maxItems": 20,
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "fixture_id",
    "fixture_version",
    "kind",
    "locale",
    "payload",
    "payload_sha256",
    "refs"
  ],
  "title": "Alpha Defense fixture envelope",
  "type": "object"
}
