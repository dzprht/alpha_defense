{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-defense.local/schemas/recommendations.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "locale",
    "reviewed_at",
    "classifications",
    "completeness",
    "recommendations",
    "selection",
    "support",
    "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "catalog_version": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "classifications": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/classification" }
    },
    "completeness": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/completenessCopy" }
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/recommendation" }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "unsupported_reason", "partial", "unavailable"],
      "properties": {
        "default": { "$ref": "#/$defs/code" },
        "unsupported_reason": { "$ref": "#/$defs/code" },
        "partial": { "$ref": "#/$defs/code" },
        "unavailable": { "$ref": "#/$defs/code" }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["with_contact", "without_contact"],
      "properties": {
        "with_contact": { "$ref": "#/$defs/plainText" },
        "without_contact": { "$ref": "#/$defs/plainText" }
      }
    },
    "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
    "plainText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^<>{}]+$"
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "risk_label", "explanation"],
      "properties": {
        "severity": { "enum": ["low", "medium", "high", "critical", "unknown"] },
        "risk_label": { "$ref": "#/$defs/plainText" },
        "explanation": { "$ref": "#/$defs/plainText" }
      }
    },
    "completenessCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completeness", "explanation"],
      "properties": {
        "completeness": { "enum": ["complete", "partial", "unavailable"] },
        "explanation": { "$ref": "#/$defs/plainText" }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "title",
        "body",
        "reason_codes",
        "education_card_codes",
        "uses_trusted_support_contact"
      ],
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "title": { "$ref": "#/$defs/plainText" },
        "body": { "$ref": "#/$defs/plainText" },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/code" }
        },
        "education_card_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/code" }
        },
        "uses_trusted_support_contact": { "type": "boolean" }
      }
    }
  }
}
