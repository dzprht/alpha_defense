{
  "components": {
    "schemas": {
      "AnonymousSessionResponse": {
        "additionalProperties": false,
        "properties": {
          "capabilities": {
            "items": {
              "const": "start_demo_session",
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "execution_mode": {
            "const": "mock",
            "default": "mock",
            "title": "Execution Mode",
            "type": "string"
          },
          "pre_session_expires_at": {
            "format": "date-time",
            "title": "Pre Session Expires At",
            "type": "string"
          },
          "status": {
            "const": "anonymous",
            "default": "anonymous",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "pre_session_expires_at",
          "capabilities"
        ],
        "title": "AnonymousSessionResponse",
        "type": "object"
      },
      "ConsentResponse": {
        "additionalProperties": false,
        "properties": {
          "changed_at": {
            "format": "date-time",
            "title": "Changed At",
            "type": "string"
          },
          "revision": {
            "minimum": 0.0,
            "title": "Revision",
            "type": "integer"
          },
          "scope": {
            "$ref": "#/components/schemas/ConsentScope"
          },
          "status": {
            "$ref": "#/components/schemas/ConsentStatus"
          }
        },
        "required": [
          "scope",
          "status",
          "revision",
          "changed_at"
        ],
        "title": "ConsentResponse",
        "type": "object"
      },
      "ConsentScope": {
        "enum": [
          "analyze_communications",
          "analyze_resources",
          "use_transaction_history",
          "send_notifications",
          "participate_in_research"
        ],
        "title": "ConsentScope",
        "type": "string"
      },
      "ConsentStatus": {
        "enum": [
          "granted",
          "revoked"
        ],
        "title": "ConsentStatus",
        "type": "string"
      },
      "DependencyStatus": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "field": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Field",
            "type": "string"
          },
          "message": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "LivenessResponse": {
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "maxLength": 36,
            "minLength": 36,
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "const": "alive",
            "default": "alive",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "request_id"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "ProblemDetails": {
        "additionalProperties": false,
        "description": "RFC 9457 response extended with stable application fields.",
        "properties": {
          "code": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Detail",
            "type": "string"
          },
          "field_errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field Errors"
          },
          "instance": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Instance",
            "type": "string"
          },
          "request_id": {
            "maxLength": 36,
            "minLength": 36,
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          },
          "status": {
            "maximum": 599.0,
            "minimum": 400.0,
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "type": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "request_id"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "minItems": 1,
            "title": "Checks",
            "type": "array"
          },
          "request_id": {
            "maxLength": 36,
            "minLength": 36,
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "SessionResponse": {
        "additionalProperties": false,
        "properties": {
          "capabilities": {
            "items": {
              "const": "update_consents",
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "consent_revision": {
            "minimum": 0.0,
            "title": "Consent Revision",
            "type": "integer"
          },
          "consents": {
            "items": {
              "$ref": "#/components/schemas/ConsentResponse"
            },
            "title": "Consents",
            "type": "array"
          },
          "execution_mode": {
            "const": "mock",
            "default": "mock",
            "title": "Execution Mode",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "namespace_id": {
            "title": "Namespace Id",
            "type": "string"
          },
          "roles": {
            "items": {
              "enum": [
                "demo_user",
                "researcher"
              ],
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "status": {
            "const": "active",
            "default": "active",
            "title": "Status",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "session_id",
          "namespace_id",
          "roles",
          "consent_revision",
          "consents",
          "expires_at",
          "capabilities"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "StartDemoSessionRequest": {
        "additionalProperties": false,
        "properties": {
          "profile_code": {
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Profile Code",
            "type": "string"
          }
        },
        "required": [
          "profile_code"
        ],
        "title": "StartDemoSessionRequest",
        "type": "object"
      },
      "UpdateConsentRequest": {
        "additionalProperties": false,
        "properties": {
          "expected_revision": {
            "minimum": 0.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/ConsentStatus"
          }
        },
        "required": [
          "status",
          "expected_revision"
        ],
        "title": "UpdateConsentRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Synthetic-data anti-fraud prototype API.",
    "title": "Alpha Defense API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/consents/{scope}": {
      "patch": {
        "operationId": "update_consent",
        "parameters": [
          {
            "in": "path",
            "name": "scope",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ConsentScope"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateConsentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem Details"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem Details"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem Details"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem Details"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem Details"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem Details"
          }
        },
        "summary": "Update Consent",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "get_liveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "get_readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Mandatory dependency is unavailable"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/session": {
      "get": {
        "operationId": "get_session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AnonymousSessionResponse"
                    },
                    {
                      "$ref": "#/components/schemas/SessionResponse"
                    }
                  ],
                  "title": "Response Get Session"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem Details"
          }
        },
        "summary": "Get Session",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/sessions/demo": {
      "post": {
        "operationId": "start_demo_session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartDemoSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem Details"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem Details"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem Details"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem Details"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem Details"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem Details"
          }
        },
        "summary": "Start Demo Session",
        "tags": [
          "identity"
        ]
      }
    }
  }
}
