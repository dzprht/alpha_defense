{
  "components": {
    "schemas": {
      "AccountCredentialsRequest": {
        "additionalProperties": false,
        "properties": {
          "login": {
            "maxLength": 64,
            "minLength": 3,
            "title": "Login",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 12,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "login",
          "password"
        ],
        "title": "AccountCredentialsRequest",
        "type": "object"
      },
      "AnonymousSessionResponse": {
        "additionalProperties": false,
        "properties": {
          "capabilities": {
            "items": {
              "const": "start_demo_session",
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "execution_mode": {
            "const": "mock",
            "default": "mock",
            "title": "Execution Mode",
            "type": "string"
          },
          "pre_session_expires_at": {
            "format": "date-time",
            "title": "Pre Session Expires At",
            "type": "string"
          },
          "status": {
            "const": "anonymous",
            "default": "anonymous",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "pre_session_expires_at",
          "capabilities"
        ],
        "title": "AnonymousSessionResponse",
        "type": "object"
      },
      "ConsentResponse": {
        "additionalProperties": false,
        "properties": {
          "changed_at": {
            "format": "date-time",
            "title": "Changed At",
            "type": "string"
          },
          "revision": {
            "minimum": 0.0,
            "title": "Revision",
            "type": "integer"
          },
          "scope": {
            "$ref": "#/components/schemas/ConsentScope"
          },
          "status": {
            "$ref": "#/components/schemas/ConsentStatus"
          }
        },
        "required": [
          "scope",
          "status",
          "revision",
          "changed_at"
        ],
        "title": "ConsentResponse",
        "type": "object"
      },
      "ConsentScope": {
        "enum": [
          "analyze_communications",
          "analyze_resources",
          "use_transaction_history",
          "send_notifications",
          "participate_in_research"
        ],
        "title": "ConsentScope",
        "type": "string"
      },
      "ConsentStatus": {
        "enum": [
          "granted",
          "revoked"
        ],
        "title": "ConsentStatus",
        "type": "string"
      },
      "DependencyStatus": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "EducationCardPageResponse": {
        "additionalProperties": false,
        "properties": {
          "content_version": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Content Version",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/EducationCardSummaryResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "locale": {
            "pattern": "^[a-z]{2}-[A-Z]{2}$",
            "title": "Locale",
            "type": "string"
          },
          "locale_fallback": {
            "title": "Locale Fallback",
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "requested_locale": {
            "pattern": "^[a-z]{2}-[A-Z]{2}$",
            "title": "Requested Locale",
            "type": "string"
          }
        },
        "required": [
          "items",
          "next_cursor",
          "locale",
          "requested_locale",
          "locale_fallback",
          "content_version"
        ],
        "title": "EducationCardPageResponse",
        "type": "object"
      },
      "EducationCardResponse": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Body",
            "type": "string"
          },
          "code": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "title": "Code",
            "type": "string"
          },
          "content_version": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Content Version",
            "type": "string"
          },
          "fallback_reason": {
            "anyOf": [
              {
                "enum": [
                  "unsupported_code",
                  "unsupported_version"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallback Reason"
          },
          "locale": {
            "pattern": "^[a-z]{2}-[A-Z]{2}$",
            "title": "Locale",
            "type": "string"
          },
          "locale_fallback": {
            "title": "Locale Fallback",
            "type": "boolean"
          },
          "requested_code": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "title": "Requested Code",
            "type": "string"
          },
          "requested_locale": {
            "pattern": "^[a-z]{2}-[A-Z]{2}$",
            "title": "Requested Locale",
            "type": "string"
          },
          "requested_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requested Version"
          },
          "reviewed_at": {
            "format": "date-time",
            "title": "Reviewed At",
            "type": "string"
          },
          "source_links": {
            "items": {
              "type": "string"
            },
            "title": "Source Links",
            "type": "array"
          },
          "summary": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "version": {
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "code",
          "version",
          "title",
          "summary",
          "body",
          "source_links",
          "reviewed_at",
          "locale",
          "requested_locale",
          "locale_fallback",
          "requested_code",
          "requested_version",
          "fallback_reason",
          "content_version"
        ],
        "title": "EducationCardResponse",
        "type": "object"
      },
      "EducationCardSummaryResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "title": "Code",
            "type": "string"
          },
          "reviewed_at": {
            "format": "date-time",
            "title": "Reviewed At",
            "type": "string"
          },
          "summary": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "version": {
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "code",
          "version",
          "title",
          "summary",
          "reviewed_at"
        ],
        "title": "EducationCardSummaryResponse",
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "field": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Field",
            "type": "string"
          },
          "message": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "LivenessResponse": {
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "maxLength": 36,
            "minLength": 36,
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "const": "alive",
            "default": "alive",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "request_id"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "ProblemDetails": {
        "additionalProperties": false,
        "description": "RFC 9457 response extended with stable application fields.",
        "properties": {
          "code": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Detail",
            "type": "string"
          },
          "field_errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field Errors"
          },
          "instance": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Instance",
            "type": "string"
          },
          "request_id": {
            "maxLength": 36,
            "minLength": 36,
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          },
          "status": {
            "maximum": 599.0,
            "minimum": 400.0,
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "type": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "request_id"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "minItems": 1,
            "title": "Checks",
            "type": "array"
          },
          "request_id": {
            "maxLength": 36,
            "minLength": 36,
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "SessionResponse": {
        "additionalProperties": false,
        "properties": {
          "auth_kind": {
            "enum": [
              "demo",
              "account"
            ],
            "title": "Auth Kind",
            "type": "string"
          },
          "capabilities": {
            "items": {
              "const": "update_consents",
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "consent_revision": {
            "minimum": 0.0,
            "title": "Consent Revision",
            "type": "integer"
          },
          "consents": {
            "items": {
              "$ref": "#/components/schemas/ConsentResponse"
            },
            "title": "Consents",
            "type": "array"
          },
          "execution_mode": {
            "const": "mock",
            "default": "mock",
            "title": "Execution Mode",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "namespace_id": {
            "title": "Namespace Id",
            "type": "string"
          },
          "roles": {
            "items": {
              "enum": [
                "demo_user",
                "researcher"
              ],
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "status": {
            "const": "active",
            "default": "active",
            "title": "Status",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "session_id",
          "namespace_id",
          "auth_kind",
          "roles",
          "consent_revision",
          "consents",
          "expires_at",
          "capabilities"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "StartDemoSessionRequest": {
        "additionalProperties": false,
        "properties": {
          "profile_code": {
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Profile Code",
            "type": "string"
          }
        },
        "required": [
          "profile_code"
        ],
        "title": "StartDemoSessionRequest",
        "type": "object"
      },
      "UpdateConsentRequest": {
        "additionalProperties": false,
        "properties": {
          "expected_revision": {
            "minimum": 0.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/ConsentStatus"
          }
        },
        "required": [
          "status",
          "expected_revision"
        ],
        "title": "UpdateConsentRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Synthetic-data anti-fraud prototype API.",
    "title": "Alpha Defense API",
    "version": "1.0.0"
  },
